+    /// Wraps a wgpu-core `Global` that another owner (for example a WebGPU
+    /// binding) keeps using, so both sides create resources in one registry
+    /// and submit on the same devices and queues.
+    ///
+    /// # Safety
+    ///
+    /// `global` must have been created by the same wgpu-core version with the
+    /// backends this build of wgpu enables.
+    pub unsafe fn from_core_global(global: alloc::sync::Arc<wgc::global::Global>) -> Self {
+        Self {
+            inner: unsafe { crate::backend::ContextWgpuCore::from_core_global(global).into() },
+        }
+    }
+
+    /// Adopts an adapter id of this instance's `Global`. The returned
+    /// [`Adapter`] drops the id: pass an id the caller owns exclusively (for
+    /// example one from `Global::adapter_clone_id`).
+    ///
+    /// # Safety
+    ///
+    /// `adapter` must be a live id of this instance's `Global`, owned by the caller.
+    pub unsafe fn adapter_from_core(&self, adapter: wgc::id::AdapterId) -> Adapter {
+        let core = crate::backend::wgpu_core::CoreAdapter {
+            context: self.inner.as_core().clone(),
+            id: adapter,
+        };
+        Adapter { inner: core.into() }
+    }
+
+    /// Adopts a device id and its queue id of this instance's `Global`. The
+    /// returned objects drop the ids; errors they report go to their own
+    /// error sink, not to the other owner's. Do not replace the device-lost
+    /// callback the other owner installed.
+    ///
+    /// # Safety
+    ///
+    /// `device` and `queue` must be live ids of this instance's `Global`, the
+    /// queue must belong to the device, and both must be owned by the caller
+    /// (for example from `Global::device_clone_id` / `queue_clone_id`).
+    pub unsafe fn device_from_core(
+        &self,
+        device: wgc::id::DeviceId,
+        queue: wgc::id::QueueId,
+    ) -> (Device, Queue) {
+        let (device, queue) = unsafe { self.inner.as_core().device_from_core(device, queue) };
+        (Device { inner: device.into() }, Queue { inner: queue.into() })
+    }
+
+    /// Adopts a texture id created on `device`. `desc` must describe the
+    /// texture as it was created; [`Texture`]'s accessors report it.
+    ///
+    /// # Safety
+    ///
+    /// `texture` must be a live id of this instance's `Global`, created on
+    /// `device` with `desc`, and owned by the caller (for example from
+    /// `Global::texture_clone_id`).
+    pub unsafe fn texture_from_core(
+        &self,
+        device: &Device,
+        texture: wgc::id::TextureId,
+        desc: &TextureDescriptor<'_>,
+    ) -> Texture {
+        let core = unsafe {
+            self.inner
+                .as_core()
+                .texture_from_core(device.inner.as_core(), texture)
+        };
+        Texture {
+            inner: core.into(),
+            descriptor: TextureDescriptor {
+                label: None,
+                view_formats: &[],
+                ..desc.clone()
+            },
+        }
+    }
 }
 
