+/// Interop between two wrappers of the same [`Global`] (for example a WebGPU
+/// binding and the `wgpu` crate used by an embedder's renderer).
+///
+/// Each method registers a *new* id for the resource behind `id`. Both ids
+/// share the same `Arc`, so the resource lives until every id is dropped and
+/// either owner may drop its id independently, in any order. The new id has
+/// no trace record of its own: with the `trace` feature a replay sees only
+/// the original creation.
+impl Global {
+    /// Registers another id for the adapter behind `id`.
+    pub fn adapter_clone_id(&self, id: AdapterId) -> AdapterId {
+        let adapter = self.hub.adapters.get(id);
+        self.hub.adapters.prepare(None).assign(adapter)
+    }
+
+    /// Registers another id for the device behind `id`.
+    pub fn device_clone_id(&self, id: DeviceId) -> DeviceId {
+        let device = self.hub.devices.get(id);
+        self.hub.devices.prepare(None).assign(device)
+    }
+
+    /// Registers another id for the queue behind `id`.
+    pub fn queue_clone_id(&self, id: QueueId) -> QueueId {
+        let queue = self.hub.queues.get(id);
+        self.hub.queues.prepare(None).assign(queue)
+    }
+
+    /// Registers another id for the texture behind `id` (also an invalid
+    /// one, which stays invalid).
+    pub fn texture_clone_id(&self, id: id::TextureId) -> id::TextureId {
+        let texture = self.hub.textures.get(id);
+        self.hub.textures.prepare(None).assign(texture)
+    }
+}
