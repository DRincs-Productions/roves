+/// `scene` restricted to `ops[start..end]`; compositor surfaces are kept only
+/// for the master's own head segment.
+pub(super) fn scene_segment_fragment(
+    scene: &Scene,
+    start: usize,
+    end: usize,
+    keep_surfaces: bool,
+) -> Scene {
+    let end = end.min(scene.ops.len());
+    let mut fragment = scene.clone();
+    fragment.ops = scene.ops[start.min(end)..end].to_vec();
+    if !keep_surfaces {
+        fragment.compositor_surfaces.clear();
+    }
+    fragment
+}
