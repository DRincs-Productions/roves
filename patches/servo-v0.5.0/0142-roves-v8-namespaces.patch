+                Ok(property == "color".encode_utf16().collect::<Vec<_>>())
+            }
+            fn Supports_(_cx: &mut ScriptContext, condition: Vec<u16>) -> Result<bool, WebIdlError> {
+                Ok(condition.starts_with(&"(".encode_utf16().collect::<Vec<_>>()))
