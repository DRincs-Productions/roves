+    /// The smoothing coefficient for a time constant of `seconds`.
+    fn coefficient(seconds: f32, sample_rate: f32) -> f32 {
+        if seconds <= 0. {
+            0.
+        } else {
+            (-1. / (seconds * sample_rate)).exp()
+        }
+    }
