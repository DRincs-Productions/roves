+                .expect("copying failed");
+            self.sample_offset.set(sample_offset + n_samples);
+        }
+        samples.clear();
+        drop(samples);
+
+        self.appsrc
+            .push_buffer(buffer)
+            .map(|_| ())
+            .map_err(|_| AudioSinkError::BufferPushFailed)
