+pub unsafe fn IsConstructor(obj: *mut JSObject) -> bool {
+    JSContext::current().with_scope(|scope| {
+        object(scope, obj).is_some_and(|target| v8::Local::<v8::Function>::try_from(target).is_ok_and(|f| f.is_constructor()))
+    })
+}
