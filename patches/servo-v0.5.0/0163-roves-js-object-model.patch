+            length_: args.argc_ as usize,
+            elements_: args.argv_ as *const _,
+        }
+    }
+}
+
+impl From<Handle<JSVal>> for HandleValueArray {
+    fn from(handle: Handle<JSVal>) -> HandleValueArray {
+        HandleValueArray {
+            length_: 1,
+            elements_: handle.ptr,
+        }
+    }
+}
