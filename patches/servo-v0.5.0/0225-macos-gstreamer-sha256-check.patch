+def _sha256_matches(path: str) -> bool:
+    expected = PACKAGE_SHA256.get(os.path.basename(path))
+    if expected is None:
+        return False
+    digest = hashlib.sha256()
+    with open(path, "rb") as package:
+        for block in iter(lambda: package.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest() == expected
+
