+        assert!(unsafe { JS_IsExceptionPending(cx) }, "a throwing trap leaves its exception pending");
+        unsafe { JS_ClearPendingException(cx) };
+        eval(&runtime, "delete globalThis.q; delete globalThis.existing; delete globalThis.k");
