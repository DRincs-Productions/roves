 /// Roves-branded hang.
 const MAX_PAGE_LOAD_SPLASH_DURATION: Duration = Duration::from_secs(8);
 
+/// Coalesces repeated redraw requests into at most one pending push at a time, reproducing
+/// winit's own `Window::request_redraw` guarantee ("Winit will aggregate duplicate redraw
+/// requests into a single event, to help avoid duplicating rendering work" — see
+/// rust-windowing/winit#1041, "Rethinking RedrawRequested") by hand, since the SDL3 backend has
+/// no equivalent built in.
+///
+/// Without this, a continuously-repainting page (any WebGL/canvas content driven by
+/// `requestAnimationFrame`, e.g. PixiJS/Three.js) can push `AppEvent::RedrawRequested` onto the
+/// SDL event queue faster than the main thread can drain it: `App::dispatch_window_event`/
+/// `dispatch_user_event` (see app.rs) both pump Servo's own event loop after handling any event,
+/// which can itself call `request_redraw` again if the `WebView` has more content ready — so
+/// dispatching one redraw can queue another, unbounded, with no backpressure. Observed for real
+/// as the whole window going "Not Responding" on Windows.
+#[derive(Default)]
+struct RedrawCoalescer(Cell<bool>);
+
+impl RedrawCoalescer {
+    /// Call when a redraw is wanted. Returns `true` the caller should actually push a new event
+    /// now (nothing was already pending); `false` if a request is already queued and this call
+    /// was coalesced away — the caller should do nothing, the already-pending one covers it.
+    fn request(&self) -> bool {
+        !self.0.replace(true)
+    }
+
+    /// Call once the pending request has actually been dispatched/handled, so the next
+    /// `request()` pushes a fresh event again instead of being coalesced against a stale one.
+    fn mark_dispatched(&self) {
+        self.0.set(false);
+    }
+}
+
+#[cfg(test)]
+mod redraw_coalescer_tests {
+    use super::RedrawCoalescer;
+
+    #[test]
+    fn first_request_is_not_coalesced() {
+        let coalescer = RedrawCoalescer::default();
+        assert!(coalescer.request());
+    }
+
+    #[test]
+    fn repeated_requests_before_dispatch_are_coalesced() {
+        let coalescer = RedrawCoalescer::default();
+        assert!(coalescer.request());
+        assert!(!coalescer.request());
+        assert!(!coalescer.request());
+    }
+
+    #[test]
+    fn request_after_dispatch_is_not_coalesced() {
+        let coalescer = RedrawCoalescer::default();
+        assert!(coalescer.request());
+        coalescer.mark_dispatched();
+        assert!(coalescer.request());
+    }
+
+    #[test]
+    fn mark_dispatched_without_a_pending_request_is_a_no_op() {
+        let coalescer = RedrawCoalescer::default();
+        coalescer.mark_dispatched();
+        assert!(coalescer.request());
+    }
+
+    #[test]
+    fn dispatch_then_two_more_requests_only_the_first_pushes() {
+        // Mirrors the real sequence that used to flood the SDL event queue: handle a redraw,
+        // which along the way (pump_servo_event_loop) may call request_redraw more than once
+        // before the next event is actually dispatched.
+        let coalescer = RedrawCoalescer::default();
+        assert!(coalescer.request());
+        coalescer.mark_dispatched();
+        assert!(coalescer.request());
+        assert!(!coalescer.request());
+    }
+}
