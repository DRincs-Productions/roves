+// Single-document route lifecycle. A History API router keeps one retained control (its own
+// popstate listener and a store of plain route summaries) while each route owns ephemeral JS
+// state: a self-capturing state object, a popstate listener registered with an AbortSignal and a
+// pending timeout. Leaving a route aborts the signal and clears the timer; afterwards nothing the
+// router keeps may reach that state. No DOM nodes are created (detached nodes are covered above).
+// This checks JS reachability only: native memory and session-history storage are not measured.
+const ROUTE_TRANSITIONS = 12;
+const ROUTE_TRAVERSE_EVERY = 4;
+
+function traverseHistory(method) {
+  return new Promise(resolve => {
+    const timer = setTimeout(() => { removeEventListener("popstate", done); resolve(false); }, FRAME_TIMEOUT_MS);
+    function done() { clearTimeout(timer); resolve(true); }
+    addEventListener("popstate", done, { once: true });
+    history[method]();
+  });
+}
+
+// Built in its own scope: V8 shares one closure context per function, so a cleanup closure created
+// inside enterRoute() would also hold the route state and root it from the router.
+function routeCleanup(controller, timer) {
+  return () => { controller.abort(); clearTimeout(timer); };
+}
+
+// Returns only WeakRefs to the route's state object, popstate listener and timeout callback.
+function enterRoute(router, index) {
+  const controller = new AbortController();
+  const state = { index, scratch: new Array(256).fill(index), visits: 0 };
+  state.render = () => state.index + state.scratch.length;
+  const onPopState = () => { state.visits++; router.routeVisits++; };
+  addEventListener("popstate", onPopState, { signal: controller.signal });
+  const onTimeout = () => { state.visits = -1; router.expiredTimers++; };
+  const timer = setTimeout(onTimeout, PENDING_TIMEOUT_MS);
+  router.leave = routeCleanup(controller, timer);
+  const url = new URL(router.baseURL);
+  url.searchParams.set("route", String(index));
+  history.pushState({ route: index }, "", url);
+  router.store.set(index, state.render());
+  return [new WeakRef(state), new WeakRef(onPopState), new WeakRef(onTimeout)];
+}
+
+function leaveRoute(router) {
+  if (router.leave) router.leave();
+  router.leave = null;
+}
+
+async function checkRouteStateRetention() {
+  const savedState = history.state;
+  const router = { baseURL: location.href, store: new Map(), leave: null,
+                   routeVisits: 0, controlVisits: 0, expiredTimers: 0 };
+  router.onControlPopState = () => { router.controlVisits++; };
+  addEventListener("popstate", router.onControlPopState);
+  const controlRef = new WeakRef(router.onControlPopState);
+  const refs = [];
+  let active = [], traversals = 0;
+  try {
+    for (let index = 0; index < ROUTE_TRANSITIONS; index++) {
+      leaveRoute(router);
+      active = enterRoute(router, index);
+      refs.push(...active);
+      // Traversals fire popstate in the same document: only the active route's listener may run.
+      if (index % ROUTE_TRAVERSE_EVERY === ROUTE_TRAVERSE_EVERY - 1) {
+        for (const method of ["back", "forward"]) {
+          if (!await traverseHistory(method)) fail("route traversal " + method + " timed out");
+          traversals++;
+        }
+      }
+      await collectOnce();
+    }
+    // Each aliveCount() runs in the task after a collection, as in checkTimerCallbackOwnership().
+    let activeAlive = 0;
