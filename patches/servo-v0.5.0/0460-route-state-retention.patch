+        location.href === router.baseURL && JSON.stringify(history.state) === JSON.stringify(savedState),
+      `identity=${identity} control=${router.controlVisits} route=${router.routeVisits} ` +
+        `traversals=${traversals} store=${router.store.size} expired=${router.expiredTimers} url=${location.href}`);
+  } finally {
+    leaveRoute(router);
+    removeEventListener("popstate", router.onControlPopState);
+    history.replaceState(savedState, "", router.baseURL);
+  }
+}
