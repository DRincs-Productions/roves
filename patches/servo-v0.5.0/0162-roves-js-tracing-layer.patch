+        }
+    }
+}
+
+macro_rules! impl_traceable_tuple {
+    () => {
+        unsafe impl Traceable for () {
+            #[inline]
+            unsafe fn trace(&self, _: *mut JSTracer) {}
+        }
+    };
+    ($($name:ident)+) => {
+        unsafe impl<$($name: Traceable,)+> Traceable for ($($name,)+) {
+            #[allow(non_snake_case)]
+            #[inline]
+            unsafe fn trace(&self, trc: *mut JSTracer) {
+                let ($(ref $name,)+) = *self;
+                $($name.trace(trc);)+
+            }
+        }
+    };
+}
