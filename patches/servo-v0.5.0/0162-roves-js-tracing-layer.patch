+
+unsafe impl<T: Traceable> Traceable for Option<T> {
+    #[inline]
+    unsafe fn trace(&self, trc: *mut JSTracer) {
+        self.as_ref().map(|t| t.trace(trc));
+    }
+}
+
+unsafe impl<T: Traceable, E: Traceable> Traceable for Result<T, E> {
+    #[inline]
+    unsafe fn trace(&self, trc: *mut JSTracer) {
+        match self {
+            Ok(t) => t.trace(trc),
