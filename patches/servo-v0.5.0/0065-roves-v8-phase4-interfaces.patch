+    #[test]
+    fn define_interface_exposes_a_constructor_on_the_global_object() {
+        let mut runtime = Runtime::new();
+        runtime.define_interface("Node", None);
+        assert_eq!(
+            runtime.eval_value("typeof Node").unwrap(),
+            Value::String("function".to_string())
