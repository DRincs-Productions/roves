+    fn trace(&self, _: &mut v8::cppgc::Visitor) {}
+
+    fn get_name(&self) -> &'static std::ffi::CStr {
+      c"Derived2"
+    }
+  }
+
+  #[repr(C)]
+  #[derive(CppgcInherits)]
+  #[cppgc_inherits_from(Derived)]
+  struct Derived2 {
+    base: Derived,
+    _value: u8,
+  }
+}
