+      scope,
+    )
+    .unwrap();
+    let obj = from.cast::<v8::Object>();
+    let key = v8::String::new(scope, "a").unwrap();
+    assert_eq!(
+      obj
+        .get(scope, key.into())
+        .unwrap()
+        .number_value(scope)
+        .unwrap(),
+      1.0
