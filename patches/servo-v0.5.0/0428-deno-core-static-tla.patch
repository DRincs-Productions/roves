+      )?;
+      // Zero-length ptrs
+      run_test2(
+        JIT_SLOW_ITERATIONS,
+        op_ptr,
+        &format!("{op_ptr}(new {arr}(0), 0, new {arr}(0), 0);"),
+      )?;
+      // UintXArray -> UintXArray
+      run_test2(
+        JIT_SLOW_ITERATIONS,
+        op,
+        &format!(
+          r"
+        let out = new {arr}(10);
+        {op}(new {arr}([1,2,3]), 3, out, 10);
