+    self.slow_fn_impl = from.slow_fn_impl;
+    self.slow_fn_with_metrics = from.slow_fn_with_metrics;
+    self.fast_fn = from.fast_fn;
+    self.fast_fn_with_metrics = from.fast_fn_with_metrics;
+    self
+  }
