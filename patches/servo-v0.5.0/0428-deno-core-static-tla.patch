+#[inline(always)]
+pub(crate) fn call_site_evals_key<'s, 'i>(
+  scope: &mut v8::PinScope<'s, 'i>,
+) -> v8::Local<'s, v8::Private> {
+  let name = v8_static_strings::CALL_SITE_EVALS.v8_string(scope).unwrap();
+  v8::Private::for_api(scope, Some(name))
+}
