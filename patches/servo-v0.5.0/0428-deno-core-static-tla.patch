+#[macro_export]
+macro_rules! scope {
+  ($scope: ident, $self: expr) => {
+    let context = $self.main_context();
+    let isolate = &mut *$self.v8_isolate();
+    $crate::v8::scope!($scope, isolate);
+    let context = $crate::v8::Local::new($scope, context);
