+
+  #[test]
+  fn test_raw() {
+    let arena: ArenaSharedAtomic<RefCell<usize>> =
+      ArenaSharedAtomic::with_capacity(16);
+    let arc = arena.allocate(Default::default());
+    let raw = ArenaArc::into_raw(arc);
