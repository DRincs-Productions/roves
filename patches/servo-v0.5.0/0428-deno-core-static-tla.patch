+#[test]
+fn terminate_execution() {
+  let (mut isolate, _dispatch_count) = setup(Mode::Async);
+  let v8_isolate_handle = isolate.v8_isolate().thread_safe_handle();
+
+  let terminator_thread = std::thread::spawn(move || {
