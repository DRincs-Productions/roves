+      pipe.internal_fd.is_none(),
+      "the raw owner must be cleared after listener adoption"
+    );
+    assert!(pipe.internal_listener.is_some());
+    assert_eq!(pipe.fd(), Some(fd));
+
+    unsafe {
+      uv_close(&mut pipe as *mut uv_pipe_t as *mut uv_handle_t, None);
+    }
+    tick(runtime).await;
+    assert_fd_closed(fd);
+  })
+  .await;
