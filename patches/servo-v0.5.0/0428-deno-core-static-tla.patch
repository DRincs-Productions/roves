+/// Returns true if the mode is a raw mode (RAW or RAW_VT).
+#[cfg(windows)]
+fn is_raw_tty_mode(mode: uv_tty_mode_t) -> bool {
+  matches!(
+    mode,
+    uv_tty_mode_t::UV_TTY_MODE_RAW | uv_tty_mode_t::UV_TTY_MODE_RAW_VT
+  )
+}
