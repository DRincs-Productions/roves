+  val: v8::Local<'sc, v8::Value>,
+) -> Option<Ref<T>> {
+  let ptr = try_unwrap_cppgc_base_object::<T>(isolate, val)?;
+  Some(Ref {
+    inner: v8::cppgc::Persistent::new(&ptr.inner),
+  })
+}
