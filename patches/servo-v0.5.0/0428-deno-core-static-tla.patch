+
+      uv_close(client_ptr as *mut uv_handle_t, None);
+      uv_close(server_ptr as *mut uv_handle_t, None);
+    }
+    // Clean up Rc leak.
+    unsafe { drop(Rc::from_raw(connected_ptr)) };
+  })
+  .await;
+}
