+#[cfg(unix)]
+fn assert_fd_closed(fd: i32) {
+  unsafe {
+    set_errno(0);
+    assert_eq!(libc::fcntl(fd, libc::F_GETFD), -1);
+  }
+  assert_eq!(get_errno(), libc::EBADF);
+}
