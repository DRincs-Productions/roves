+pub type GlobalObjectMiddlewareFn =
+  for<'s, 'i> fn(&mut v8::PinScope<'s, 'i>, v8::Local<'s, v8::Object>);
+
+extern "C" fn noop() {}
+
+const NOOP_FN: CFunction = CFunction::new(
+  noop as _,
+  &CFunctionInfo::new(Type::Void.as_info(), &[], Int64Representation::Number),
+);
