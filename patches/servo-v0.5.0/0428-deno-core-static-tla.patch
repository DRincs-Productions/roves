+      )?;
+      // Resizable
+      run_test2(
+        JIT_SLOW_ITERATIONS,
+        op,
+        &format!(
+          r"
+        let inbuf = new ArrayBuffer(10 * {size}, {{ maxByteLength: 100 * {size} }});
+        let in_u8 = new {arr}(inbuf);
+        in_u8[5] = 1;
+        let out = new ArrayBuffer(10 * {size}, {{ maxByteLength: 100 * {size} }});
+        {op}(new {arr}(inbuf, 5 * {size}, 5), 5, new {arr}(out), 10);
+        assert(new {arr}(out)[0] == 1);"
+        ),
+      )?;
+    }
+    Ok(())
+  }
