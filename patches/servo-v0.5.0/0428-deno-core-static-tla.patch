+/// Tick the event loop once with a real waker (so tokio's reactor works).
+async fn tick(runtime: &mut JsRuntime) {
+  poll_fn(|cx| {
+    let _ = runtime.poll_event_loop(cx, PollEventLoopOptions::default());
+    Poll::Ready(())
+  })
+  .await;
+}
