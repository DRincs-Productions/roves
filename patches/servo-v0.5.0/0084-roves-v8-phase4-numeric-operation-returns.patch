+                self.assertIn(f"fn {method}(&self) -> {rust_type};", source)
+            self.assertIn("Value::Number(native.FloatValue() as f64)", source)
+            self.assertIn("Value::Number(native.UnsignedLongLongValue() as f64)", source)
