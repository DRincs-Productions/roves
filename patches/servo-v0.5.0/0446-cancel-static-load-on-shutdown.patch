+            let _ = self.network.send((url.to_owned(), sender));
+            let guard = FetchGuard(self.dropped.clone());
+            Box::pin(async move {
+                let _guard = guard;
+                receiver.await.unwrap_or_else(|_| Err("the network thread went away".to_owned()))
+            })
+        }
+    }
+
+    struct NetworkRuntime {
