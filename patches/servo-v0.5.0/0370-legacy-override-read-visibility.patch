+      resolve(body(frame.contentWindow, frame.contentDocument, cleanup));
+    } catch (error) {
+      resolve(String((error && error.message) || error));
+    } finally {
+      for (const undo of cleanup.reverse()) { try { undo(); } catch (_) {} }
