+    }
+    let corner_radius = egui::CornerRadius::same(2);
+    let painter = ui.painter();
+    painter.rect_filled(
+        outer_rect,
+        corner_radius,
+        egui::Color32::from_white_alpha(28),
+    );
+    painter.rect_stroke(
+        outer_rect,
+        corner_radius,
+        egui::Stroke::new(1.0, egui::Color32::from_white_alpha(90)),
+        egui::StrokeKind::Outside,
+    );
