+                text.split(|unit| *unit == b',' as u16).map(<[u16]>::to_vec).collect()
+            }
+            fn Grid(&self, size: u32) -> Vec<Vec<i32>> {
+                (0..size as i32).map(|row| (0..size as i32).map(|column| row * 10 + column).collect()).collect()
+            }
