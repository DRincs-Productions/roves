+
+        report = measure()
+        self.assertGreater(report["total"], 400)
+        self.assertIn("ValidityState", report["supported"])
+        self.assertIn("Screen", report["supported"])
+        self.assertEqual(len(report["supported"]) + len(report["rejected"]), report["total"])
