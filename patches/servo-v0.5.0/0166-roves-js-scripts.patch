+pub unsafe fn DumpJSStack(cx: *mut JSContext, _show_args: bool, _show_locals: bool, _show_this_props: bool) {
+    let text = raw(cx).with_scope(|scope| stack_text(scope, usize::MAX));
+    eprintln!("{text}");
