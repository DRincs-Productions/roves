+use crate::reflector::{DomObject, MutDomObject, NativeObjectId, Reflector};
 use crate::trace::trace_reflector;
 
+#[cfg(test)]
+mod native_identity_tests {
+    use std::collections::hash_map::DefaultHasher;
+    use std::hash::{Hash, Hasher};
+
+    use super::Dom;
+    use crate::reflector::Reflector;
+
+    #[test]
+    fn dom_equality_and_hash_use_native_identity() {
+        let first = Reflector::<()>::new();
+        let first_alias = Dom::from_ref(&first);
+        let second = Reflector::<()>::new();
+        let second_dom = Dom::from_ref(&second);
+
+        assert_eq!(first_alias, first_alias.clone());
+        assert_ne!(first_alias, second_dom);
+
+        let mut first_hasher = DefaultHasher::new();
+        first_alias.hash(&mut first_hasher);
+        let mut alias_hasher = DefaultHasher::new();
+        first_alias.clone().hash(&mut alias_hasher);
+        let mut second_hasher = DefaultHasher::new();
+        second_dom.hash(&mut second_hasher);
+        assert_eq!(first_hasher.finish(), alias_hasher.finish());
+        assert_ne!(first_hasher.finish(), second_hasher.finish());
+    }
+}
