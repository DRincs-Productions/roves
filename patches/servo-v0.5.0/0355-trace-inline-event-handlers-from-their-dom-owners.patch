+// nodes whose handler is a self-capturing closure, or a content attribute compiled by reading
+// the IDL attribute (its scope chain holds the element), must be collectable. Nodes with a
+// never-compiled attribute only check the fixture itself. Returns WeakRefs per kind.
+function dropInlineHandlerNodes(size) {
+  const refs = { closure: [], compiled: [], uncompiled: [] };
+  for (let i = 0; i < size; i++) {
+    const closure = document.createElement("div");
+    closure.onclick = () => { closure.rovesHits = (closure.rovesHits || 0) + 1; };
+    refs.closure.push(new WeakRef(closure));
+    const compiled = document.createElement("div");
