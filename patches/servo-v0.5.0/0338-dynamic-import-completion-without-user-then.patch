+        let patches = [
+            "function () { hijacked++; throw new Error('hijacked'); }",
+            "function (f) { hijacked++; if (typeof f === 'function') f(); return 'hostile'; }",
+        ];
+        for patch in patches {
+            let mut runtime = Runtime::new(JSEngineHandle::for_tests());
