+def v8_wrap_ce_reactions(registration: str) -> str:
+    """Wraps the body of every member closure in a registration (getter, setter, operation or
+    overload) in `<T as roves_v8::CeReactions>::with_ce_reactions`, as Servo's generated
+    bindings push and pop the custom element reaction queue around [CEReactions] members.
+    Closures are found by their `|native` parameter list and matched by braces."""
+    fallible = "define_fallible_webidl_method" in registration or "WebIdlOverload" in registration
+    output = []
+    index = 0
+    while True:
+        start = registration.find("|native", index)
+        if start < 0:
+            output.append(registration[index:])
+            return "".join(output)
+        params_end = registration.index("|", start + 1)
+        params = registration[start:params_end + 1]
+        open_brace = registration.index("{", params_end)
+        depth = 0
+        close_brace = open_brace
+        for position in range(open_brace, len(registration)):
+            if registration[position] == "{":
+                depth += 1
+            elif registration[position] == "}":
+                depth -= 1
+                if depth == 0:
+                    close_brace = position
+                    break
+        body = registration[open_brace + 1:close_brace]
+        if params == "|native|":
+            result = "Value"
+        elif "value" in params:
+            result = "()"
+        else:
+            result = "Result<Value, roves_v8::WebIdlError>" if fallible else "Value"
+        output.append(registration[index:open_brace])
+        output.append(
+            "{ <T as roves_v8::CeReactions>::with_ce_reactions(move || -> "
+            + result + " {" + body + "}) }"
+        )
+        index = close_brace + 1
+
