+unsafe extern "C" fn get_prototype(
+    cx: *mut RawJSContext,
+    proxy: RawHandleObject,
+    proto: RawMutableHandleObject,
+) -> bool {
+    let mut cx = unsafe {
+        // SAFETY: V8 calls proxy traps with the current live script context.
