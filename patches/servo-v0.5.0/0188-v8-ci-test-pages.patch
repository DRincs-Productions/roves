+  const px = pixel(gl, 1, 1);
+  return (px[0] === 255 && px[1] === 255 && px[2] === 0) || `pixel ${px}`;
+});
+check("WebGL: context attributes, extensions and limits", () => {
+  const gl = makeCanvas().getContext("webgl", { antialias: false, alpha: false });
+  if (!gl) return "no webgl";
+  const attributes = gl.getContextAttributes();
+  return attributes.alpha === false && Array.isArray(gl.getSupportedExtensions()) && gl.getParameter(gl.MAX_TEXTURE_SIZE) >= 1024;
+});
+check("canvas 2D: paths, gradients, text and getImageData", () => {
+  const canvas = makeCanvas(32, 32);
+  const g = canvas.getContext("2d");
+  const gradient = g.createLinearGradient(0, 0, 32, 0);
+  gradient.addColorStop(0, "#000000"); gradient.addColorStop(1, "#ffffff");
+  g.fillStyle = gradient; g.fillRect(0, 0, 32, 16);
+  g.beginPath(); g.arc(16, 24, 6, 0, Math.PI * 2); g.fillStyle = "rgb(0, 0, 255)"; g.fill();
+  g.font = "10px sans-serif"; g.fillStyle = "red"; g.fillText("R", 0, 10);
+  const left = g.getImageData(1, 14, 1, 1).data, right = g.getImageData(30, 14, 1, 1).data, circle = g.getImageData(16, 24, 1, 1).data;
+  return (left[0] < right[0] && circle[2] === 255 && g.measureText("Roves").width > 0) || `left ${left} right ${right} circle ${circle}`;
+});
+check("canvas 2D: drawImage, transforms and putImageData", () => {
+  const source = makeCanvas(4, 4);
+  const sg = source.getContext("2d"); sg.fillStyle = "#00ff00"; sg.fillRect(0, 0, 4, 4);
+  const canvas = makeCanvas(16, 16);
+  const g = canvas.getContext("2d");
+  g.translate(8, 8); g.scale(2, 2); g.drawImage(source, 0, 0);
+  g.setTransform(1, 0, 0, 1, 0, 0);
+  const image = g.createImageData(1, 1); image.data.set([255, 0, 255, 255]);
+  g.putImageData(image, 0, 0);
+  const drawn = g.getImageData(12, 12, 1, 1).data, put = g.getImageData(0, 0, 1, 1).data;
+  return (drawn[1] === 255 && put[0] === 255 && put[2] === 255) || `drawn ${drawn} put ${put}`;
+});
+check("canvas toDataURL and toBlob encode PNG", () => new Promise(resolve => {
+  const canvas = makeCanvas(4, 4);
+  canvas.getContext("2d").fillRect(0, 0, 4, 4);
+  const url = canvas.toDataURL("image/png");
+  canvas.toBlob(blob => resolve((url.startsWith("data:image/png;base64,") && blob && blob.type === "image/png" && blob.size > 0) || `${url.slice(0, 30)} ${blob && blob.type}`), "image/png");
+}));
+check("Image decoding from a data URL and drawing it", () => new Promise(resolve => {
+  const source = makeCanvas(2, 2);
+  const sg = source.getContext("2d"); sg.fillStyle = "#0000ff"; sg.fillRect(0, 0, 2, 2);
+  const image = new Image();
+  image.onload = () => {
+    const g = makeCanvas(2, 2).getContext("2d");
+    g.drawImage(image, 0, 0);
+    const px = g.getImageData(1, 1, 1, 1).data;
+    resolve((image.naturalWidth === 2 && px[2] === 255) || `size ${image.naturalWidth} pixel ${px}`);
+  };
+  image.onerror = () => resolve("image error");
+  image.src = source.toDataURL();
+}));
+check("Path2D and isPointInPath", () => {
+  const g = makeCanvas().getContext("2d");
+  const path = new Path2D("M0 0 L10 0 L10 10 Z");
+  return g.isPointInPath(path, 8, 2) && !g.isPointInPath(path, 2, 8);
+});
+check("WebGPU adapter request (when available)", async () => {
+  if (!navigator.gpu) return "skip";
+  const adapter = await navigator.gpu.requestAdapter();
+  return adapter ? true : "skip";
+});
+finish();
+</script>
+</body></html>
diff --git a/support/v8-smoke/harness.js b/support/v8-smoke/harness.js
new file mode 100644
index 00000000000..945abcf0bc4
--- /dev/null
+++ b/support/v8-smoke/harness.js
@@ -0,0 +1,28 @@
+// Shared harness of the V8 smoke pages: `check(name, fn)` runs a synchronous or asynchronous
+// check (returning true to pass, "skip" when the environment lacks the feature, anything else
+// as the failure detail), after the previous one; `finish()` waits for every check and prints
+// the lines run.sh reads.
+"use strict";
+const results = [];
+// Checks run one after another, so a check installing global handlers (onerror,
+// unhandledrejection) never sees another check's events.
+let chain = Promise.resolve();
+
+function check(name, fn, timeoutMs = 10000) {
+  chain = chain.then(() => {
+    const run = (async () => fn())();
+    return Promise.race([run, new Promise(resolve => setTimeout(() => resolve("timeout"), timeoutMs))])
+      .then(outcome => results.push([name, outcome]), error => results.push([name, String((error && error.stack) || error)]));
+  });
+}
+
+async function finish() {
+  await chain;
+  let passed = 0, skipped = 0;
+  for (const [name, outcome] of results) {
+    if (outcome === "skip") { skipped++; console.log("SUITE SKIP " + name); continue; }
+    if (outcome === true) passed++;
+    console.log((outcome === true ? "SUITE PASS " : "SUITE FAIL ") + name + (outcome === true ? "" : " :: " + outcome));
+  }
+  console.log("SUITE TOTAL " + passed + "/" + (results.length - skipped) + (skipped ? " (" + skipped + " skipped)" : ""));
+}
