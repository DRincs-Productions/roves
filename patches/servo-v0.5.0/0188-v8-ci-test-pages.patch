+  return (left[0] === 255 && right[1] === 255 && gl.getError() === gl.NO_ERROR) || `left ${left} right ${right} error ${gl.getError()}`;
+});
+check("WebGL 2: render to a framebuffer texture", () => {
+  const gl = makeCanvas().getContext("webgl2");
+  if (!gl) return "no webgl2";
+  const texture = gl.createTexture();
+  gl.bindTexture(gl.TEXTURE_2D, texture);
+  gl.texStorage2D(gl.TEXTURE_2D, 1, gl.RGBA8, 4, 4);
+  const framebuffer = gl.createFramebuffer();
