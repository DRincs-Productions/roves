+<!doctype html>
+<html><head><meta charset="utf-8"><title>roves-js ES modules</title>
+<script src="harness.js"></script>
+<script type="importmap">{ "imports": { "shapes": "./modules/b.mjs" } }</script>
+</head>
+<body>
+<script type="module">
+// ES modules on V8: a static module graph loaded from files, cycles, top-level await, JSON
+// modules, import maps, import.meta and evaluation errors.
+import { a, bump, metaUrl } from "./modules/a.mjs";
+import Shape, { counter } from "./modules/b.mjs";
+import { sum } from "./modules/cycle1.mjs";
+
+check("static imports link a module graph", () => a === "ab" && new Shape().area() === 0);
+check("a module shared by two importers is evaluated once", () => { bump(); return counter.value === 1 && globalThis.__bEvaluations === 1; });
+check("cyclic imports resolve live bindings", () => sum() === 3);
+check("import.meta.url names the module file", () => metaUrl.endsWith("/modules/a.mjs") || metaUrl);
+check("dynamic import returns the same module namespace", async () => {
+  const again = await import("./modules/b.mjs");
+  return again.counter === counter && again.default === Shape;
+});
+check("dynamic import waits for top-level await", async () => (await import("./modules/tla.mjs")).ready === "ready");
+check("JSON module with import attributes", async () => {
+  const data = await import("./modules/data.json", { with: { type: "json" } });
+  return data.default.level === 4 && data.default.names[1] === "v8";
+});
+check("import map resolves a bare specifier", async () => (await import("shapes")).b === "b");
+check("a throwing module rejects its import", async () => {
+  try { await import("./modules/broken.mjs"); return "no error"; } catch (error) { return error.message === "module evaluation failed on purpose" || String(error); }
+});
+check("a missing module rejects its import", async () => {
+  try { await import("./modules/does-not-exist.mjs"); return "no error"; } catch (error) { return error instanceof TypeError || String(error); }
+});
+check("a syntax error in a module rejects its import", async () => {
+  const url = URL.createObjectURL(new Blob(["export const = ;"], { type: "text/javascript" }));
+  try { await import(url); return "no error"; } catch (error) { return error instanceof SyntaxError || String(error); }
+});
+check("module namespace objects are frozen and sealed", async () => {
+  const ns = await import("./modules/b.mjs");
+  return Object.isFrozen(ns) === false && Object.isSealed(ns) && Object.prototype.toString.call(ns) === "[object Module]";
+});
+await finish();
+</script>
+</body></html>
