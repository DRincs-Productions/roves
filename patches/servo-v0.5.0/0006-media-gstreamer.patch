+def is_separately_packaged_dylib(library_path: str) -> bool:
+    """Returns true for dependency lines from otool that this walker must not try to
+    resolve/copy itself, because something else already packages them correctly.
+
+    `libsteam_api.dylib` (only present with `--features steam`, see Cargo.toml) is the one
