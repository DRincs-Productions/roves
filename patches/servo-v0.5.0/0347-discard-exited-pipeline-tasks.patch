new file mode 100644
index 00000000000..1cba0bfc01a
--- /dev/null
+++ b/.github/workflows/v8.yml
@@ -0,0 +1,232 @@
+name: V8 migration checks
+
+# Use workflow_dispatch to retry transient runner or dependency-download failures.
+
+on:
+  push:
+    paths:
+      - 'components/roves-v8/**'
+      - 'components/roves-js/**'
+      - 'components/script_bindings/**'
+      - 'components/script/task_queue.rs'
+      - 'components/script/script_thread.rs'
+      - 'support/task-queue-tests/**'
+      - 'support/v8_cutover_check.py'
+      - 'support/v8-smoke/**'
+      - '.github/workflows/v8.yml'
+  workflow_dispatch: {}
+
+concurrency:
+  group: v8-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  runtime:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, windows-latest, macos-latest]
+        mode: [normal, jitless]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: dtolnay/rust-toolchain@1.95.0
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: isolate the runtime crate from unrelated Servo dependencies
+        shell: bash
+        run: |
+          mkdir -p "$RUNNER_TEMP/roves-v8/src"
+          cp components/roves-v8/Cargo.toml components/roves-v8/Cargo.lock "$RUNNER_TEMP/roves-v8/"
+          cp -R components/roves-v8/src/. "$RUNNER_TEMP/roves-v8/src/"
+          # roves-js (the mozjs API on V8) builds next to roves-v8, with its own lockfile.
+          cp -R components/roves-js "$RUNNER_TEMP/roves-js"
+      - name: test smoke runner failure contracts
+        shell: bash
+        run: python -m unittest discover -s support/v8-smoke -p test_runner.py
+      - name: test discarded-pipeline task ownership
+        if: matrix.mode == 'normal'
+        shell: bash
+        env:
+          CARGO_TARGET_DIR: ${{ runner.temp }}/task-queue-contracts
+        run: cargo test --locked --manifest-path support/task-queue-tests/Cargo.toml
+      - name: test runtime and compile-fail safety contracts
+        shell: bash
+        env:
+          V8_TEST_MODE: ${{ matrix.mode }}
+        run: |
+          cd "$RUNNER_TEMP/roves-v8"
+          args=()
+          if [ "$V8_TEST_MODE" = jitless ]; then
+            args+=(--features jitless)
+          fi
+          cargo test --locked "${args[@]}"
+          # The mozjs-on-V8 layer of the cutover (value model, cells, rooting).
+          cd "$RUNNER_TEMP/roves-js"
+          if [ "$V8_TEST_MODE" = jitless ]; then
+            cargo test --locked --features jitless
+          else
+            cargo test --locked
+          fi
+
+  # servoshell built against roves-js (the mozjs API on V8) instead of SpiderMonkey on every
+  # desktop platform Roves ships, then (Linux) the smoke pages in support/v8-smoke/ run
+  # headlessly. This is the end-to-end check of the V8 cutover, kept in CI so no local machine
+  # has to link the browser.
+  servoshell-v8:
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-24.04, windows-latest, macos-latest]
+        mode: [normal]
+        include:
+          # V8 without its JIT, the console configuration (docs/V8_MIGRATION.md, "JIT-less").
+          - os: ubuntu-24.04
+            mode: jitless
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 180
+    steps:
+      - uses: actions/checkout@v4
+      - name: make mach executable
+        if: runner.os != 'Windows'
+        run: chmod +x mach
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - uses: astral-sh/setup-uv@v5
+      # See release.yml: background apt jobs can hold the dpkg lock right after boot.
+      - name: stop background apt processes
+        if: runner.os == 'Linux'
+        run: |
+          sudo systemctl stop apt-daily.timer apt-daily-upgrade.timer 2>/dev/null || true
+          sudo systemctl kill --kill-who=all apt-daily.service apt-daily-upgrade.service unattended-upgrades.service 2>/dev/null || true
+          sudo pkill -9 -f unattended-upgrade 2>/dev/null || true
+          for i in $(seq 1 60); do
+            sudo fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock >/dev/null 2>&1 || exit 0
+            sleep 1
+          done
+      # See test.yml: GStreamer's Windows installer, run without elevation, at the path mach
+      # expects; `--skip-platform` then keeps bootstrap from trying again.
+      - name: install GStreamer (Windows, non-interactive)
+        if: runner.os == 'Windows'
+        shell: pwsh
+        run: |
+          $ErrorActionPreference = "Stop"
+          $version = "1.28.7"
+          $name = "gstreamer-1.0-msvc-x86_64-$version.exe"
+          $installer = Join-Path $env:RUNNER_TEMP $name
+          # Our own copy first (see gstreamer-mirror.yml); gstreamer.freedesktop.org cuts responses
+          # after ~1 MiB, so it is only the fallback, fetched by resuming until complete.
+          $mirror = "https://github.com/DRincs-Productions/roves/releases/download/deps-gstreamer-$version/$name"
+          $url = "https://gstreamer.freedesktop.org/data/pkg/windows/$version/msvc/$name"
+          try {
+            Invoke-WebRequest -Uri $mirror -OutFile $installer
+          } catch {
+            Write-Host "GStreamer mirror unavailable ($_), falling back to gstreamer.freedesktop.org"
+            $length = [int64](((curl.exe -sIL $url) -match '^content-length:' | Select-Object -Last 1) -replace '\D', '')
+            for ($request = 0; -not ((Test-Path $installer) -and (Get-Item $installer).Length -ge $length); $request++) {
+              if ($request -ge 4000) { throw "GStreamer download did not complete" }
+              curl.exe -sSL -C - -o $installer $url
+              if ($LASTEXITCODE -ne 0) { Start-Sleep -Seconds 5 }
+            }
+          }
+          $installDir = Join-Path (Get-Location) "target\dependencies\gstreamer\1.0\msvc_X86_64"
+          New-Item -ItemType Directory -Force -Path (Split-Path $installDir) | Out-Null
+          $proc = Start-Process -FilePath $installer -ArgumentList @(
+            "/CURRENTUSER", "/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/DIR=`"$installDir`""
+          ) -Wait -PassThru
+          if ($proc.ExitCode -ne 0) { throw "GStreamer installer failed with exit code $($proc.ExitCode)" }
+      # See test.yml: apt's downloaded packages live in an Actions cache, not only on the mirror.
+      - name: restore cached apt packages
+        if: runner.os == 'Linux'
+        uses: actions/cache/restore@v4
+        with:
+          path: |
+            ~/apt-archives
+            !~/apt-archives/lock
+            !~/apt-archives/partial
+          key: apt-v8-${{ runner.os }}-${{ hashFiles('python/servo/platform/linux_packages/apt/*.txt') }}-${{ github.run_id }}-${{ github.run_attempt }}
+          restore-keys: |
+            apt-v8-${{ runner.os }}-${{ hashFiles('python/servo/platform/linux_packages/apt/*.txt') }}-
+            apt-v8-${{ runner.os }}-
+      - name: point apt's package cache at the cached directory
+        if: runner.os == 'Linux'
+        run: |
+          mkdir -p "$HOME/apt-archives/partial"
+          sudo chmod -R a+rwX "$HOME/apt-archives"
+          printf 'Dir::Cache::Archives "%s";\nAPT::Keep-Downloaded-Packages "true";\n' "$HOME/apt-archives" | sudo tee /etc/apt/apt.conf.d/99roves-apt-cache
+      - name: mach bootstrap (system build dependencies)
+        timeout-minutes: 60
+        shell: bash
+        env:
+          DEBIAN_FRONTEND: noninteractive
+        run: |
+          if [ "$RUNNER_OS" = Linux ]; then
+            # servoshell's default features build without GStreamer (no gstreamer-sys in its
+            # graph). Its development packages were ~450 of the 485 packages mach installs, and
+            # the runner's apt mirror timed this step out several times. Install the rest, as
+            # mach does (only packages this release has), then skip mach's platform step.
+            sudo apt-get update
+            available=$(apt-cache --generate pkgnames)
+            packages=$(grep -hv -e '^#' -e '^$' python/servo/platform/linux_packages/apt/apt_common.txt \
+              | grep -v -e gstreamer -e '^libges' \
+              | grep -Fxf <(echo "$available"))
+            # shellcheck disable=SC2086
+            bash support/apt_prefetch.sh $packages
+            # shellcheck disable=SC2086
+            sudo apt-get install -y -m --no-install-recommends $packages
+          fi
+          if [ "$RUNNER_OS" = macOS ]; then
+            ./mach bootstrap --force --yes --skip-lints --skip-nextest
+          else
+            ./mach bootstrap --force --yes --skip-lints --skip-nextest --skip-platform
+          fi
+      # Saved even when bootstrap fails or times out: the next run resumes the download.
+      # apt's lock and partial downloads are root-only: drop them so tar can read the rest.
+      - name: prepare apt packages for caching
+        if: always() && runner.os == 'Linux'
+        shell: bash
+        run: sudo rm -rf "$HOME/apt-archives/lock" "$HOME/apt-archives/partial" && sudo chmod -R a+rX "$HOME/apt-archives" || true
+      - name: save apt packages
+        if: always() && runner.os == 'Linux'
+        uses: actions/cache/save@v4
+        with:
+          path: |
+            ~/apt-archives
+            !~/apt-archives/lock
+            !~/apt-archives/partial
+          key: apt-v8-${{ runner.os }}-${{ hashFiles('python/servo/platform/linux_packages/apt/*.txt') }}-${{ github.run_id }}-${{ github.run_attempt }}
+      - name: free disk space
+        if: runner.os == 'Linux'
+        run: sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL || true
+      - name: build servoshell on roves-js (V8)
+        shell: bash
+        run: |
+          features=""
+          if [ "${{ matrix.mode }}" = jitless ]; then features="--features roves-js/jitless"; fi
+          python support/v8_cutover_check.py servoshell --build --online --top 40 $features
+          ls target/v8-cutover/debug/servoshell*
+      # Linux normal only: one extra debug servoshell process (one page, bounded by its 60 s
+      # timeout) loads frame-retention.html and writes one native V8 heap snapshot of a removed
+      # blank frame; its size follows the page's JS heap. Kept 3 days, for reading retainers in
+      # DevTools' Memory panel. The smoke step fails when the requested snapshot is missing.
+      - name: run the V8 smoke pages headlessly
+        if: runner.os == 'Linux'
+        env:
+          V8_SMOKE_MODE: ${{ matrix.mode }}
+          V8_SMOKE_ALLOW_MISSING_DEVICES: '1'
+          V8_SMOKE_HEAP_SNAPSHOT: ${{ matrix.mode == 'normal' && format('{0}/target/v8-heap-snapshot/frame-retention.heapsnapshot', github.workspace) || '' }}
+        run: |
+          sudo apt-get install -y --no-install-recommends xvfb
+          chmod +x support/v8-smoke/run.sh
+          support/v8-smoke/run.sh "$PWD/target/v8-cutover/debug/servoshell" xvfb-run -a --server-args="-screen 0 1280x720x24"
+      - name: upload the removed-frame heap snapshot
+        if: always() && runner.os == 'Linux' && matrix.mode == 'normal'
+        uses: actions/upload-artifact@v4
+        with:
+          name: v8-heap-snapshot-frame-retention
+          path: target/v8-heap-snapshot/frame-retention.heapsnapshot
+          retention-days: 3
+          if-no-files-found: warn
