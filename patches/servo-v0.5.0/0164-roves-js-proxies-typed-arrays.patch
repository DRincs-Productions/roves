+pub trait IntoHandle {
+    type Target;
+    fn into_handle(self) -> crate::jsapi::Handle<Self::Target>;
+}
+
+/// Conversion to a raw mutable handle (mozjs_sys's `jsgc::IntoMutableHandle`).
+pub trait IntoMutableHandle: IntoHandle {
