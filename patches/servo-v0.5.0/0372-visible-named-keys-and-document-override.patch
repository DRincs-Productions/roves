+  const form = doc.createElement("form");
+  doc.body.append(form);
+  // Defined while the name is not supported yet (no named setter), then the control is added.
+  Object.defineProperty(form, key, { configurable: true, writable: true, enumerable: true, value: "own" });
+  const shadowed = doc.createElement("input"), plain = doc.createElement("input");
+  shadowed.name = key;
+  plain.name = plainKey;
+  form.append(shadowed, plain);
+  let queried = 0;
+  Object.setPrototypeOf(form, new Proxy(win.HTMLFormElement.prototype, {
+    has(target, property) {
+      if (property === key) { queried++; throw new Error("prototype queried for an own name"); }
+      return Reflect.has(target, property);
+    },
+  }));
+  let keys;
+  try {
+    keys = Reflect.ownKeys(form);
+  } catch (error) {
+    return `ownKeys threw: ${(error && error.message) || error}`;
+  }
+  const count = keys.filter(k => k === key).length;
+  if (count !== 1) problems.push(`own name listed ${count} times`);
+  if (keys.filter(k => k === plainKey).length !== 1) problems.push("plain name not listed once");
+  try {
+    const desc = Object.getOwnPropertyDescriptor(form, key);
+    if (form[key] !== "own" || !Object.hasOwn(form, key) || !desc || desc.value !== "own" || desc.writable !== true)
+      problems.push(`own name: get=${describeValue(form[key])} ${describeDescriptor(desc)}`);
+  } catch (error) {
+    problems.push(`read threw: ${(error && error.message) || error}`);
+  }
+  if (queried) problems.push(`prototype queried ${queried} times`);
+  return problems.length ? problems.join("; ") : true;
+}));
