+fn can_direct_present(conditions: DirectPresentConditions) -> bool {
+    let DirectPresentConditions {
+        single_webview,
+        full_window,
+        no_dialogs,
+        no_status_overlay,
+        no_egui_focus,
+        accessibility_idle,
+        textures_idle,
+    } = conditions;
+    single_webview &&
+        full_window &&
+        no_dialogs &&
+        no_status_overlay &&
+        no_egui_focus &&
+        accessibility_idle &&
+        textures_idle
+}
