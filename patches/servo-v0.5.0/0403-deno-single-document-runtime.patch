+        "cached promise was lost or replaced");
+  check("font ready retained result survives collection", await after === fonts,
+        "fulfillment changed");
+}
+// FONT_READY_CONTRACT_END
+
+// deref() keeps a live target for the current job only; no target is stored.
+function aliveCount(refs) {
+  let alive = 0;
+  for (const ref of refs) if (ref.deref() !== undefined) alive++;
+  return alive;
+}
+
+// Collects until every target is gone, at most MAX_COLLECTIONS times. Survivors fail the page.
+async function expectCollected(name, refs) {
+  let alive = refs.length, rounds = 0;
+  while (alive > 0 && rounds < MAX_COLLECTIONS) {
+    await collectOnce();
+    rounds++;
+    alive = aliveCount(refs);
+  }
