+/// Feeds a decoded `data:` URL to the image cache as a complete response. Returns false (so the
+/// caller falls back to a normal fetch) when the URL cannot be decoded.
+fn load_data_url_image(url: &ServoUrl, id: PendingImageId, cache: &Arc<dyn ImageCache>) -> bool {
+    let Ok(data_url) = data_url::DataUrl::process(url.as_str()) else {
+        return false;
+    };
+    let Ok((bytes, _fragment)) = data_url.decode_to_vec() else {
+        return false;
+    };
+    let mut metadata = Metadata::default(url.clone());
+    let mime = data_url.mime_type().to_string().parse::<mime::Mime>().ok();
+    metadata.set_content_type(mime.as_ref());
+
+    let request_id = RequestId::default();
+    cache.notify_pending_response(
+        id,
+        FetchResponseMsg::ProcessResponse(request_id, Ok(FetchMetadata::Unfiltered(metadata))),
+    );
+    cache.notify_pending_response(
+        id,
+        FetchResponseMsg::ProcessResponseChunk(request_id, bytes.into()),
+    );
+    cache.notify_pending_response(
+        id,
+        FetchResponseMsg::ProcessResponseEOF(
+            request_id,
+            Ok(()),
+            ResourceFetchTiming::new(ResourceTimingType::None),
+        ),
+    );
+    true
+}
