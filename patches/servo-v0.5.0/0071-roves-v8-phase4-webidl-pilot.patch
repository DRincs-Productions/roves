+class CGV8BindingRoot(CGThing):
+    """First V8 backend slice: real, nonconstructible readonly boolean interfaces.
+
+    Fail closed on unsupported WebIDL rather than silently dropping members. This
+    backend is explicitly selected by run_v8.py; SpiderMonkey generation is unchanged.
+    Native trait methods match Servo's existing MakeNativeName convention.
+    """
+    def __init__(self, interface: IDLInterface) -> None:
+        self.interface = interface
+
+    def define(self) -> str:
+        interface = self.interface
+        name = interface.identifier.name
+        if (interface.isNamespace() or interface.isCallback() or interface.parent is not None
+                or interface.ctor() is not None):
+            raise TypeError(f"V8 backend does not yet support interface shape: {name}")
+        unsupported = set(interface._extendedAttrDict) - {"Exposed"}
+        if unsupported:
+            raise TypeError(f"V8 backend unsupported attributes on {name}: {sorted(unsupported)}")
+        exposed = interface._extendedAttrDict.get("Exposed")
+        if exposed is None or not ({"Window", "*"} & set(exposed)):
+            raise TypeError(f"V8 pilot only supports interfaces exposed to Window: {name}")
+        attributes = []
+        for member in interface.members:
+            if (not member.isAttr() or not member.readonly or member.isStatic()
+                    or not member.type.isBoolean() or member.type.nullable()
+                    or member._extendedAttrDict):
+                raise TypeError(f"V8 backend unsupported member: {name}.{member.identifier.name}")
+            attributes.append((member.identifier.name, MakeNativeName(member.identifier.name)))
+        trait_methods = "\n".join(f"    fn {native}(&self) -> bool;" for _, native in attributes)
