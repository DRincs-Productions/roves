+
+#[allow(non_snake_case)]
+pub trait {name}Native: 'static {{
+{trait_methods}
+}}
+
+/// Typed binding generated from {name}.webidl. The private interface prevents
+/// pairing callbacks for one native Rust type with an unrelated wrapped type.
+pub struct {name}Binding<T: {name}Native> {{
+    interface: Interface,
+    native: std::marker::PhantomData<fn() -> T>,
+}}
+
+impl<T: {name}Native> {name}Binding<T> {{
+    pub fn install(runtime: &mut Runtime) -> Result<Self, String> {{
+        let interface = runtime.define_interface("{name}", None);
