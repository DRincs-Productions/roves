+            f'        runtime.define_property(&interface, "{idl}", |native| {{\n'
+            f'            let native = native.downcast_ref::<T>().expect("typed {name} wrapper");\n'
+            f'            Value::Bool(native.{native}())\n'
+            f'        }})?;' for idl, native in attributes
+        )
