   document.body.append(frame);
 }));
+// Required by check_results.py (REQUIRED_CHECKS): keep the name in sync.
+check("an iframe keeps its WindowProxy across origin changes and back", () => new Promise(resolve => {
+  // A same-origin srcdoc document, then an opaque-origin one (sandbox="allow-scripts", no
+  // allow-same-origin), then a same-origin one again: the held WindowProxy must stay the
+  // frame's window, cross-origin access must throw a SecurityError DOMException while the
+  // cross-origin allowlist keeps working, and access must come back with the last document.
+  // Under file:// both origins serialize as "null": the access checks tell them apart.
+  const token = `origin-change-${Date.now()}-${Math.random().toString(36).slice(2)}`;
+  const parentOrigin = self.origin;
+  const frame = document.createElement("iframe");
+  const waiting = new Map();
+  let phase = "same", done = false, held = null;
+  const end = outcome => {
+    if (done) return;
+    done = true;
+    clearTimeout(timer);
+    removeEventListener("message", onMessage);
+    frame.remove();
+    resolve(outcome);
+  };
+  const timer = setTimeout(() => end(`timeout waiting for phase ${phase}`), 8000);
+  function onMessage(event) {
+    const data = event.data;
+    if (!data || data.token !== token) return;
+    const deliver = waiting.get(data.phase);
+    if (!deliver) return end(`unexpected message for phase ${data.phase} while waiting for ${phase}`);
+    waiting.delete(data.phase);
+    deliver(event);
+  }
+  addEventListener("message", onMessage);
+  const message = name => new Promise(deliver => { phase = name; waiting.set(name, deliver); });
+  const child = (name, body) => `<p id="marker">${name}</p><script>window.rovesOriginPhase = "${name}";${body}<\/script>`;
+  const post = name => `parent.postMessage({ token: "${token}", phase: "${name}", origin: self.origin, parentDocument: (() => { try { return parent.document ? "accessible" : "none"; } catch (error) { return error.name; } })() }, "*");`;
+  const securityError = (problems, label, get) => {
+    try { get(); problems.push(`${label} did not throw`); }
+    catch (error) { if (!(error instanceof DOMException && error.name === "SecurityError")) problems.push(`${label} threw ${error && error.name}`); }
+  };
+  const common = (problems, event, origin) => {
+    if (frame.contentWindow !== held) problems.push("contentWindow changed");
+    if (event.source !== held) problems.push("source is not the held window");
+    if (event.origin !== origin) problems.push(`origin ${event.origin}`);
+    if (event.data.origin !== origin) problems.push(`child origin ${event.data.origin}`);
+  };
+  const sameOrigin = (problems, event, name) => {
+    common(problems, event, parentOrigin);
+    if (event.data.parentDocument !== "accessible") problems.push(`child parent.document ${event.data.parentDocument}`);
+    const marker = held.document.getElementById("marker");
+    if (held.document !== frame.contentDocument) problems.push("document differs from contentDocument");
+    if (!marker || marker.textContent !== name) problems.push(`document shows ${marker && marker.textContent}`);
+    if (held.rovesOriginPhase !== name) problems.push(`global phase ${held.rovesOriginPhase}`);
+  };
+  const report = (name, problems) => { if (problems.length) throw new Error(`${name}: ${problems.join(", ")}`); };
+  (async () => {
+    let event, problems;
+    const first = message("same");
+    frame.srcdoc = child("same", post("same"));
+    document.body.append(frame);
+    event = await first;
+    held = frame.contentWindow;
+    sameOrigin(problems = [], event, "same");
+    report("same", problems);
+
+    const opaque = message("opaque");
+    frame.setAttribute("sandbox", "allow-scripts");
+    frame.srcdoc = child("opaque", `addEventListener("message", event => { if (!event.data || event.data.token !== "${token}" || event.data.phase !== "ping") return; event.source.postMessage({ token: "${token}", phase: "echo", origin: self.origin, from: event.origin, fromParent: event.source === parent }, "*"); });` + post("opaque"));
+    event = await opaque;
+    common(problems = [], event, "null");
+    if (event.data.parentDocument !== "SecurityError") problems.push(`child parent.document ${event.data.parentDocument}`);
+    if (frame.contentDocument !== null) problems.push("contentDocument is not null");
+    securityError(problems, "document", () => held.document);
+    securityError(problems, "global", () => held.rovesOriginPhase);
+    if (held.closed !== false || held.window !== held || held.self !== held || held.frames !== held || held.length !== 0 || held.parent !== window || typeof held.postMessage !== "function")
+      problems.push("cross-origin allowlist unusable");
+    report("opaque", problems);
+    const echo = message("echo");
+    held.postMessage({ token, phase: "ping" }, "*");
+    event = await echo;
+    common(problems = [], event, "null");
+    if (event.data.from !== parentOrigin || event.data.fromParent !== true) problems.push(`ping seen from ${event.data.from} parent ${event.data.fromParent}`);
+    report("echo", problems);
+
+    const last = message("final");
+    frame.removeAttribute("sandbox");
+    frame.srcdoc = child("final", post("final"));
+    event = await last;
+    sameOrigin(problems = [], event, "final");
+    report("final", problems);
+    end(true);
+  })().catch(error => end(String((error && error.message) || error)));
+}));
 finish();
 </script>
 </body></html>
