+    /// Each realm's `ns.owner()` and the importer of `ns.load()`.
+    fn observe(runtime: &Runtime, globals: [*mut JSObject; 2]) -> (Vec<i32>, Vec<i32>) {
+        let cx = runtime.raw_cx();
+        let mut owners = Vec::new();
+        for global in globals {
