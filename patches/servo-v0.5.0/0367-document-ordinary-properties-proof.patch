+diff --git a/components/roves-js/src/tests.rs b/components/roves-js/src/tests.rs
+index 8df4bc779a0..e939bebe743 100644
+--- a/components/roves-js/src/tests.rs
++++ b/components/roves-js/src/tests.rs
+@@ -6787,3 +6787,164 @@ fn gc_callbacks_report_full_collections() {
+     assert!(GC_EVENTS.with(|events| events.borrow().is_empty()));
+ }
