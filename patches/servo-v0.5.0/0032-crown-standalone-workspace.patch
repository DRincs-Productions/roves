diff --git a/support/crown/Cargo.toml b/support/crown/Cargo.toml
--- a/support/crown/Cargo.toml
+++ b/support/crown/Cargo.toml
@@ -7,7 +7,18 @@
 publish = false
 
 # Do not use workspace dependencies in this package!
-# crown is not part of the Cargo workspace.
+# crown is not part of the Cargo workspace. The root Cargo.toml's own `workspace.exclude`
+# only stops the *root* workspace from claiming this package -- it does not stop Cargo's
+# manifest search from continuing to walk further up looking for some *other* ancestor
+# workspace when invoked directly from this directory (`cd support/crown && cargo ...`,
+# exactly what `mach test-unit` does). In a plain checkout there's nothing further up to
+# find, so this never mattered upstream -- but this repo's own CI checks this whole tree
+# out at a path that itself sits under another, unrelated Cargo workspace (this repo's own
+# real root Cargo.toml, one level above the fresh pristine+patched reconstruction test.yml
+# builds from), which Cargo would otherwise find and fail against with "current package
+# believes it's in a workspace when it's not". An empty `[workspace]` table makes this
+# package its own workspace root, so Cargo never looks past it either way.
+[workspace]
 [dev-dependencies]
 compiletest_rs = { version = "0.11", features = ["tmp"] }
 
