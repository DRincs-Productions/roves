diff --git a/components/media/backends/gstreamer/audio_sink.rs b/components/media/backends/gstreamer/audio_sink.rs
index 8a5c43a..236d91f 100644
--- a/components/media/backends/gstreamer/audio_sink.rs
+++ b/components/media/backends/gstreamer/audio_sink.rs
@@ -171,6 +171,19 @@ impl AudioSink for GStreamerAudioSink {
     fn play(&self) -> Result<(), AudioSinkError> {
         self.pipeline
             .set_state(gstreamer::State::Playing)
+            .map_err(|_| AudioSinkError::StateChangeFailed)?;
+        // Roves: `set_state` can report success while the transition is still
+        // pending (`GST_STATE_CHANGE_ASYNC`) -- e.g. while `autoaudiosink` is
+        // still opening the real output device, which on Windows/WASAPI can
+        // take a few hundred ms on a cold start. Block here until the
+        // pipeline has actually reached PLAYING, so a short one-shot sound
+        // (WebAudio's common case: UI clicks, footsteps, ...) can't finish
+        // and tear this pipeline down again before a single sample has
+        // reached the device. See CUSTOMIZATIONS.md's "GStreamer audio sink:
+        // wait for the real PLAYING transition" entry.
+        self.pipeline
+            .state(gstreamer::ClockTime::from_seconds(5))
+            .0
             .map(|_| ())
             .map_err(|_| AudioSinkError::StateChangeFailed)
     }
