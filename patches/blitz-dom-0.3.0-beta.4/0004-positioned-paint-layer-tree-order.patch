+/// Whether `node` is positioned (`position` other than `static`).
+fn is_positioned(node: &Node) -> bool {
+    node.primary_styles()
+        .is_some_and(|style| style.clone_position() != Position::Static)
+}
+
+/// Tree-order sort key of `id`: its index path from the root through DOM
+/// parents (`::before` first and `::after` last among an element's children).
+fn tree_order_path(tree: &NodeTree, id: NodeId) -> Vec<usize> {
+    let mut path = Vec::new();
+    let mut current = id;
+    while let Some(parent_id) = tree.get(current).and_then(|node| node.parent) {
+        let Some(parent) = tree.get(parent_id) else {
+            break;
+        };
+        let index = match parent.children.iter().position(|&child| child == current) {
+            Some(index) => index + 1,
+            None if parent.before() == Some(current) => 0,
+            None => usize::MAX,
+        };
+        path.push(index);
+        current = parent_id;
+    }
+    path.reverse();
+    path
+}
